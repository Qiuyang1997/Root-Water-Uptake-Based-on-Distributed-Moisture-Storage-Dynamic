import os
from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt


input_path = Path(r"Pathway to layer-wise FDR data.xlsx")
output_root = input_path.parent / "output path"
output_root.mkdir(exist_ok=True)

# set as sensor depth: [20, 40, 70, 100, 130, 160] for 1# and [10, 30, 50, 70, 100, 130] for 2#
sensor_depths = np.array([10, 30, 50, 70, 100, 130], dtype=float)
dz_cm = 1
P_factors = [0.5, 0.6 , 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0]# Different infiltration coefficients

theta_rel_sigma = 0.03# Error input
n_mc = 500 #Monte Carlo simulation iterations

# grid building

def build_grid(dz_cm, z_top=0, z_bottom=130):
    z_edges = np.arange(z_top, z_bottom + 1e-6, dz_cm)
    if z_edges[-1] < z_bottom:
        z_edges = np.append(z_edges, z_bottom)
    dz = np.diff(z_edges)
    z_mid = (z_edges[:-1] + z_edges[1:]) / 2
    return z_edges, z_mid, dz

# Hierarchical linear interpolation
def interpolate_theta(row, z_mid):
    theta_sensor = pd.to_numeric(row[[f"R{i}" for i in range(1, 7)]], errors="coerce").values

    for i in range(6):
        if np.isnan(theta_sensor[i]) and i > 0:
            theta_sensor[i] = theta_sensor[i - 1]


    for i in range(5, -1, -1):
        if np.isnan(theta_sensor[i]) and i < 5:
            theta_sensor[i] = theta_sensor[i + 1]

    theta_sensor = np.nan_to_num(theta_sensor, nan=0.0)
    theta_sensor = theta_sensor / 100.0

    layer_bounds = [
        (0, 10, theta_sensor[0], theta_sensor[0]),
        (10, 30, theta_sensor[0], theta_sensor[1]),
        (30, 50, theta_sensor[1], theta_sensor[2]),
        (50, 70, theta_sensor[2], theta_sensor[3]),
        (70, 100, theta_sensor[3], theta_sensor[4]),
        (100, 130, theta_sensor[4], theta_sensor[5])
    ]

    theta_mid = np.zeros_like(z_mid)
    for i, z in enumerate(z_mid):
        for (z1, z2, th1, th2) in layer_bounds:
            if z1 <= z <= z2:
                theta_mid[i] = th1 if th1 == th2 else th1 + (th2 - th1) * (z - z1) / (z2 - z1)
                break
    return theta_mid


# Hierarchical linear interpolation with Monte Carlo simulation

def interpolate_theta_with_error(row, z_mid, theta_rel_sigma):
    theta_sensor = pd.to_numeric(row[[f"R{i}" for i in range(1, 7)]], errors="coerce").values

    for i in range(6):
        if np.isnan(theta_sensor[i]) and i > 0:
            theta_sensor[i] = theta_sensor[i - 1]
    for i in range(5, -1, -1):
        if np.isnan(theta_sensor[i]) and i < 5:
            theta_sensor[i] = theta_sensor[i + 1]

    theta_sensor = np.nan_to_num(theta_sensor, nan=0.0)

    eps = np.random.normal(0.0, theta_rel_sigma, size=theta_sensor.shape)
    theta_sensor = np.clip(theta_sensor + eps, 0.0, None)

    theta_sensor = theta_sensor / 100.0

    layer_bounds = [
        (0, 10, theta_sensor[0], theta_sensor[0]),
        (10, 30, theta_sensor[0], theta_sensor[1]),
        (30, 50, theta_sensor[1], theta_sensor[2]),
        (50, 70, theta_sensor[2], theta_sensor[3]),
        (70, 100, theta_sensor[3], theta_sensor[4]),
        (100, 130, theta_sensor[4], theta_sensor[5])
    ]

    theta_mid = np.zeros_like(z_mid)
    for i, z in enumerate(z_mid):
        for (z1, z2, th1, th2) in layer_bounds:
            if z1 <= z <= z2:
                theta_mid[i] = th1 if th1 == th2 else th1 + (th2 - th1) * (z - z1) / (z2 - z1)
                break
    return theta_mid

# water storage calculation

def compute_storage(theta_mid, dz_cm):
    S_layers = theta_mid * dz_cm * 10.0
    return S_layers, S_layers.sum()

# Method1

def bottom_up_min_drainage(DeltaS_layers, D_bal):
    N = len(DeltaS_layers)
    q = np.zeros(N + 1)
    ET = np.zeros(N)

    q[N] = max(D_bal, 0)

    for i in range(N - 1, -1, -1):
        q[i] = max(0, q[i + 1] + DeltaS_layers[i])
        ET[i] = q[i] - q[i + 1] - DeltaS_layers[i]
        if ET[i] < 0 and ET[i] > -1e-6:
            ET[i] = 0
    return q, ET

# Method2

def top_down_max_ET(DeltaS_layers, P_eff, ET_obs):
    N = len(DeltaS_layers)
    q = np.zeros(N + 1)
    ET = np.zeros(N)

    q[0] = max(P_eff, 0)
    R = max(ET_obs, 0)

    for i in range(N):
        ET_i_max = max(0, q[i] - DeltaS_layers[i])
        ET[i] = min(R, ET_i_max)
        q[i + 1] = q[i] - ET[i] - DeltaS_layers[i]
        if q[i + 1] < 0 and q[i + 1] > -1e-6:
            q[i + 1] = 0
        R -= ET[i]

    if q[N] < 0:
        q[N] = 0
    return q, ET
# Main
def main():
    df = pd.read_excel(input_path)

    df["date"] = pd.to_datetime(df["date"], errors="coerce")
    df = df.dropna(subset=["date"])
    df = df.sort_values("date").reset_index(drop=True)

    df["ET_obs"] = df["VT"] + df["Es"]

    z_edges, z_mid, dz = build_grid(dz_cm)
    N = len(dz)

    # ===== 确定性储水量 =====
    S_tot_list = []
    S_layers_all = []

    for _, row in df.iterrows():
        theta_mid = interpolate_theta(row, z_mid)
        S_layers, S_tot = compute_storage(theta_mid, dz_cm)
        S_tot_list.append(S_tot)
        S_layers_all.append(S_layers)

    S_tot_arr = np.array(S_tot_list)
    S_layers_all = np.array(S_layers_all)

    # ===== 主循环：不同 P_factor =====
    for pf in P_factors:
        pf_dir = output_root / f"Pfactor_{pf:.2f}"
        pf_dir.mkdir(exist_ok=True)

        records_daily = []
        records_layer = []
        print(f"准备计算 P_factor = {pf:.2f}")

        # ============================
        # 逐日计算（确定性 OK 判定）
        # ============================
        for t in range(len(df)):
            row = df.loc[t]
            date = row["date"]
            P = row["P"]
            ET_obs = row["ET_obs"]

            P_eff = P * pf

            if t == 0:
                DeltaS_tot_det = 0
                DeltaS_layers_det = np.zeros(N)
            else:
                DeltaS_tot_det = S_tot_arr[t] - S_tot_arr[t - 1]
                DeltaS_layers_det = S_layers_all[t] - S_layers_all[t - 1]

            D_bal_raw_det = P_eff - ET_obs - DeltaS_tot_det

            # ★★★ OK 判定固定（方案 A）★★★
            if D_bal_raw_det < -5:
                records_daily.append({"date": date, "status": "skipped", "D_bal_raw": D_bal_raw_det})
                continue

            D_bal_det = max(D_bal_raw_det, 0)

            q_bu_det, ET_bu_det = bottom_up_min_drainage(DeltaS_layers_det, D_bal_det)
            q_td_det, ET_td_det = top_down_max_ET(DeltaS_layers_det, P_eff, ET_obs)

            records_daily.append({
                "date": date,
                "status": "ok",
                "ET_obs": ET_obs,
                "ET_mod_bottomup": ET_bu_det.sum(),
                "D_bal_raw": D_bal_raw_det,
                "D_mod_topdown": q_td_det[-1],
                "ET_bu_0_60": ET_bu_det[:60].sum(),
                "ET_bu_60_130": ET_bu_det[60:].sum(),
                "ET_td_0_60": ET_td_det[:60].sum(),
                "ET_td_60_130": ET_td_det[60:].sum(),
                "S_tot": S_tot_arr[t],
                "S_0_60": S_layers_all[t][:60].sum(),
                "S_60_130": S_layers_all[t][60:].sum(),
                "q_60cm_bottomup": q_bu_det[60],
                "q_60cm_topdown": q_td_det[60]
            })

            for i in range(N):
                if z_edges[i] in sensor_depths:
                    records_layer.append({
                        "date": date,
                        "depth": z_edges[i],
                        "ET": ET_bu_det[i],
                        "q": q_bu_det[i]
                    })

        df_daily = pd.DataFrame(records_daily)
        df_layer = pd.DataFrame(records_layer)

        df_ok = df_daily[df_daily["status"] == "ok"].iloc[1:].copy()

        # 如果没有 OK 日，跳过该 P_factor
        if df_ok.empty:
            print(f"P_factor={pf:.2f} 没有 OK 日，跳过")
            continue

        df_ok["date_mpl"] = df_ok["date"].map(pd.Timestamp.toordinal)

        # ===== 保存 Excel =====
        df_daily.to_excel(str(pf_dir / "daily_results.xlsx"), index=False)


        # Result plotting
        plt.figure(figsize=(10, 4))
        plt.plot(df_ok["date_mpl"], df_ok["ET_obs"], color="steelblue")
        plt.scatter(df_ok["date_mpl"], df_ok["ET_mod_bottomup"], color="darkorange")
        plt.savefig(pf_dir / "ET_obs_vs_ET_mod.png", dpi=300, bbox_inches="tight")
        plt.close()

        plt.figure(figsize=(10, 4))
        plt.plot(df_ok["date_mpl"], df_ok["D_bal_raw"], color="steelblue")
        plt.scatter(df_ok["date_mpl"], df_ok["D_mod_topdown"], color="darkorange")
        plt.savefig(pf_dir / "D_raw_vs_D_mod.png", dpi=300, bbox_inches="tight")
        plt.close()


        df_layer_ok = df_layer[df_layer["date"].isin(df_ok["date"])].copy()
        df_layer_ok["date_mpl"] = df_layer_ok["date"].map(pd.Timestamp.toordinal)


        plt.figure(figsize=(10, 4))
        for depth in sensor_depths:
            sub = df_layer_ok[df_layer_ok["depth"] == depth]
            plt.plot(sub["date_mpl"], sub["ET"], label=f"{depth} cm")
        plt.legend()
        plt.savefig(pf_dir / "ET_depth.png", dpi=300, bbox_inches="tight")
        plt.close()


        plt.figure(figsize=(10, 4))
        for depth in sensor_depths:
            sub = df_layer_ok[df_layer_ok["depth"] == depth]
            plt.plot(sub["date_mpl"], sub["q"], label=f"{depth} cm")
        plt.legend()
        plt.savefig(pf_dir / "q_depth.png", dpi=300, bbox_inches="tight")
        plt.close()

        ET_cum_bu = np.zeros(N)
        ET_cum_td = np.zeros(N)
        q_cum_bu = np.zeros(N + 1)
        q_cum_td = np.zeros(N + 1)

        for t in range(1, len(df)):
            if df_daily.loc[t, "status"] != "ok":
                continue

            DeltaS_layers = S_layers_all[t] - S_layers_all[t - 1]
            D_bal_raw = df_daily.loc[t, "D_bal_raw"]
            D_bal = max(D_bal_raw, 0)

            q_bu, ET_bu = bottom_up_min_drainage(DeltaS_layers, D_bal)
            q_td, ET_td = top_down_max_ET(DeltaS_layers, df.loc[t, "P"] * pf, df.loc[t, "ET_obs"])

            ET_cum_bu += ET_bu
            ET_cum_td += ET_td
            q_cum_bu += q_bu
            q_cum_td += q_td


        plt.figure(figsize=(5, 8))
        plt.plot(ET_cum_bu, z_mid, color="steelblue", label="Bottom-up")
        plt.plot(ET_cum_td, z_mid, color="darkorange", label="Top-down")
        ax = plt.gca()
        ax.invert_yaxis()
        ax.spines['bottom'].set_visible(False)
        ax.spines['right'].set_visible(False)
        ax.grid(True, linestyle="--", alpha=0.5)
        #plt.legend()
        plt.savefig(pf_dir / "ET_cumulative_profile.png", dpi=300, bbox_inches="tight")
        plt.close()

        plt.figure(figsize=(5, 8))
        plt.plot(q_cum_bu[:-1], z_mid, color="steelblue", label="Bottom-up")
        plt.plot(q_cum_td[:-1], z_mid, color="darkorange", label="Top-down")
        ax = plt.gca()
        ax.invert_yaxis()
        ax.xaxis.set_ticks_position('top')
        ax.xaxis.set_label_position('top')
        ax.spines['top'].set_visible(False)
        ax.spines['right'].set_visible(False)
        ax.grid(True, linestyle="--", alpha=0.5)
        #plt.legend()
        plt.savefig(pf_dir / "q_cumulative_profile.png", dpi=300, bbox_inches="tight")
        plt.close()



        # Monte Carlo uncertainty analysis
        ET_cum_bu_mc = np.zeros((n_mc, N))
        ET_cum_td_mc = np.zeros((n_mc, N))
        q_cum_bu_mc = np.zeros((n_mc, N + 1))
        q_cum_td_mc = np.zeros((n_mc, N + 1))

        for k in range(n_mc):
            if k % 20 == 0:
                print(f"  Monte Carlo：{k}/{n_mc}")

            S_layers_mc = np.zeros_like(S_layers_all)
            S_tot_mc = np.zeros_like(S_tot_arr)


            for t in range(len(df)):
                theta_mid_t = interpolate_theta_with_error(df.loc[t], z_mid, theta_rel_sigma)
                S_layers_t, S_tot_t = compute_storage(theta_mid_t, dz_cm)
                S_layers_mc[t] = S_layers_t
                S_tot_mc[t] = S_tot_t

            ET_cum_bu_k = np.zeros(N)
            ET_cum_td_k = np.zeros(N)
            q_cum_bu_k = np.zeros(N + 1)
            q_cum_td_k = np.zeros(N + 1)

            for t in range(1, len(df)):
                if df_daily.loc[t, "status"] != "ok":
                    continue

                DeltaS_layers_mc = S_layers_mc[t] - S_layers_mc[t - 1]
                DeltaS_tot_mc = S_tot_mc[t] - S_tot_mc[t - 1]

                P_eff_mc = df.loc[t, "P"] * pf
                ET_obs_mc = df.loc[t, "ET_obs"]

                D_bal_raw_mc = P_eff_mc - ET_obs_mc - DeltaS_tot_mc
                if D_bal_raw_mc < -5:
                    continue
                D_bal_mc = max(D_bal_raw_mc, 0)

                q_bu_mc, ET_bu_mc = bottom_up_min_drainage(DeltaS_layers_mc, D_bal_mc)
                q_td_mc, ET_td_mc = top_down_max_ET(DeltaS_layers_mc, P_eff_mc, ET_obs_mc)

                ET_cum_bu_k += ET_bu_mc
                ET_cum_td_k += ET_td_mc
                q_cum_bu_k += q_bu_mc
                q_cum_td_k += q_td_mc

            ET_cum_bu_mc[k] = ET_cum_bu_k
            ET_cum_td_mc[k] = ET_cum_td_k
            q_cum_bu_mc[k] = q_cum_bu_k
            q_cum_td_mc[k] = q_cum_td_k

        print("Monte Carlo uncertainty analysis done")

        def mean_ci(arr):
            mean = np.mean(arr, axis=0)
            low = np.percentile(arr, 2.5, axis=0)
            high = np.percentile(arr, 97.5, axis=0)
            return mean, low, high

        ET_bu_mean, ET_bu_low, ET_bu_high = mean_ci(ET_cum_bu_mc)
        ET_td_mean, ET_td_low, ET_td_high = mean_ci(ET_cum_td_mc)
        q_bu_mean, q_bu_low, q_bu_high = mean_ci(q_cum_bu_mc[:, :-1])
        q_td_mean, q_td_low, q_td_high = mean_ci(q_cum_td_mc[:, :-1])


        # Result plotting of Monte Carlo uncertainty analysis

        plt.figure(figsize=(5, 8))
        plt.plot(ET_bu_mean, z_mid, color="steelblue", label="Bottom-up mean")
        plt.fill_betweenx(z_mid, ET_bu_low, ET_bu_high, color="lightsteelblue", edgecolor="none", alpha=0.7)
        plt.plot(ET_td_mean, z_mid, color="darkorange", label="Top-down mean")
        plt.fill_betweenx(z_mid, ET_td_low, ET_td_high, color="bisque",edgecolor="none", alpha=0.85)
        ax = plt.gca()
        ax.invert_yaxis()
        ax.xaxis.set_ticks_position('top')
        ax.xaxis.set_label_position('top')
        ax.spines['bottom'].set_visible(False)
        ax.spines['right'].set_visible(False)
        ax.grid(True, linestyle="--", alpha=0.5)
        #plt.legend()
        plt.savefig(pf_dir / "ET_cumulative_profile_with_uncertainty.png", dpi=300, bbox_inches="tight")
        plt.close()


        plt.figure(figsize=(5, 8))
        plt.plot(q_bu_mean, z_mid, color="steelblue", label="Bottom-up mean")
        plt.fill_betweenx(z_mid, q_bu_low, q_bu_high, color="lightsteelblue",edgecolor="none", alpha=0.7)
        plt.plot(q_td_mean, z_mid, color="darkorange", label="Top-down mean")
        plt.fill_betweenx(z_mid, q_td_low, q_td_high, color="bisque",edgecolor="none", alpha=0.85)
        ax = plt.gca()
        ax.invert_yaxis()
        ax.grid(True, linestyle="--", alpha=0.5)
        ax.xaxis.set_ticks_position('top')
        ax.xaxis.set_label_position('top')
        ax.spines['bottom'].set_visible(False)
        ax.spines['right'].set_visible(False)
        #plt.legend()
        plt.savefig(pf_dir / "q_cumulative_profile_with_uncertainty.png", dpi=300, bbox_inches="tight")
        plt.close()

        from scipy.signal import savgol_filter

        ET_bu_std = np.std(ET_cum_bu_mc, axis=0)
        ET_td_std = np.std(ET_cum_td_mc, axis=0)

        plt.figure(figsize=(6, 8))
        ax = plt.gca()

        plt.scatter(ET_bu_std, z_mid, color="blue", alpha=0.6, label="Std (Bottom-up)")

        ET_bu_std_smooth = savgol_filter(ET_bu_std, 11, 3)  # window=11, poly=3
        plt.plot(ET_bu_std_smooth, z_mid, color="blue", linewidth=2)

        residuals_bu = ET_bu_std - ET_bu_std_smooth
        res_std_bu = np.std(residuals_bu)
        x_upper_bu = ET_bu_std_smooth + 1.96 * res_std_bu
        x_lower_bu = ET_bu_std_smooth - 1.96 * res_std_bu
        plt.fill_betweenx(z_mid, x_lower_bu, x_upper_bu,
                          color="blue", alpha=0.2, edgecolor="none")

        ax.spines["right"].set_visible(False)
        ax.spines["bottom"].set_visible(False)
        ax.xaxis.set_ticks_position("top")
        ax.xaxis.set_label_position("top")
        ax.yaxis.set_ticks_position("left")

        ax.invert_yaxis()
        plt.xlabel("Standard deviation of ET (mm)")
        plt.ylabel("Depth (cm)")
        plt.grid(True, linestyle="--", alpha=0.5)
        # plt.legend()

        plt.savefig(pf_dir / "ET_bottomup_std_profile.png", dpi=300, bbox_inches="tight")
        plt.close()


        plt.figure(figsize=(6, 8))
        ax = plt.gca()

        plt.scatter(ET_td_std, z_mid, color="blue", alpha=0.6, label="Std (TD)")

        ET_td_std_smooth = savgol_filter(ET_td_std, 11, 3)  # window=11, poly=3
        plt.plot(ET_td_std_smooth, z_mid, color="blue", linewidth=2)

        residuals_td = ET_td_std - ET_td_std_smooth
        res_std_td = np.std(residuals_td)
        x_upper_td = ET_td_std_smooth + 1.96 * res_std_td
        x_lower_td = ET_td_std_smooth - 1.96 * res_std_td
        plt.fill_betweenx(z_mid, x_lower_td, x_upper_td,
                          color="blue", alpha=0.2, edgecolor="none")

        ax.spines["right"].set_visible(False)
        ax.spines["bottom"].set_visible(False)
        ax.xaxis.set_ticks_position("top")
        ax.xaxis.set_label_position("top")
        ax.yaxis.set_ticks_position("left")

        ax.invert_yaxis()
        plt.xlabel("Standard deviation of ET (mm)")
        plt.ylabel("Depth (cm)")
        plt.grid(True, linestyle="--", alpha=0.5)
        # plt.legend()

        plt.savefig(pf_dir / "ET_TD_std_profile.png", dpi=300, bbox_inches="tight")
        plt.close()

        plt.figure(figsize=(6, 8))
        ax = plt.gca()

        plt.scatter(ET_bu_std, z_mid, color="blue", alpha=0.6, label="Std (Bottom-up)")
        plt.scatter(ET_td_std, z_mid, color="darkorange", alpha=0.6, label="Std (Top-down)")

        ET_bu_std_smooth = savgol_filter(ET_bu_std, 11, 3)
        plt.plot(ET_bu_std_smooth, z_mid, color="blue", linewidth=2)
        ET_td_std_smooth = savgol_filter(ET_td_std, 11, 3)
        plt.plot(ET_td_std_smooth, z_mid, color="darkorange", linewidth=2)

        residuals_bu = ET_bu_std - ET_bu_std_smooth
        res_std_bu = np.std(residuals_bu)
        plt.fill_betweenx(z_mid,
                          ET_bu_std_smooth - 1.96 * res_std_bu,
                          ET_bu_std_smooth + 1.96 * res_std_bu,
                          color="blue", alpha=0.2, edgecolor="none")

        residuals_td = ET_td_std - ET_td_std_smooth
        res_std_td = np.std(residuals_td)
        plt.fill_betweenx(z_mid,
                          ET_td_std_smooth - 1.96 * res_std_td,
                          ET_td_std_smooth + 1.96 * res_std_td,
                          color="darkorange", alpha=0.2, edgecolor="none")

        ax.spines["right"].set_visible(False)
        ax.spines["bottom"].set_visible(False)
        ax.xaxis.set_ticks_position("top")
        ax.xaxis.set_label_position("top")
        ax.yaxis.set_ticks_position("left")

        ax.invert_yaxis()
        plt.xlabel("Standard deviation of ET (mm)")
        plt.ylabel("Depth (cm)")
        plt.grid(True, linestyle="--", alpha=0.5)
        #plt.legend()

        plt.savefig(pf_dir / "ET_XX_std_profile.png", dpi=300, bbox_inches="tight")
        plt.close()

        # Save Excel

        df_uncertainty = pd.DataFrame({
            "Depth_cm": z_mid,
            "ET_bottomup_mean": ET_bu_mean,
            "ET_bottomup_low": ET_bu_low,
            "ET_bottomup_high": ET_bu_high,
            "ET_topdown_mean": ET_td_mean,
            "ET_topdown_low": ET_td_low,
            "ET_topdown_high": ET_td_high,
            "q_bottomup_mean": q_bu_mean,
            "q_bottomup_low": q_bu_low,
            "q_bottomup_high": q_bu_high,
            "q_topdown_mean": q_td_mean,
            "q_topdown_low": q_td_low,
            "q_topdown_high": q_td_high
        })

        out_uncertainty_path = pf_dir / "uncertainty_results.xlsx"
        df_uncertainty.to_excel(str(out_uncertainty_path), index=False)


if __name__ == "__main__":
    main()
