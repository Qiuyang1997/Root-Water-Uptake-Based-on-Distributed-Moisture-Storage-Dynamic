def build_grid(dz_cm, z_top=0, z_bottom=160):
    z_edges = np.arange(z_top, z_bottom + 1e-6, dz_cm)
    if z_edges[-1] < z_bottom:
        z_edges = np.append(z_edges, z_bottom)
    dz = np.diff(z_edges)
    z_mid = (z_edges[:-1] + z_edges[1:]) / 2
    return z_edges, z_mid, dz


def bin_sum_1d(arr, bin_edges, dz_cm):
    n_bins = len(bin_edges) - 1
    binned = np.zeros(n_bins)
    for i in range(n_bins):
        start = int(round(bin_edges[i] / dz_cm))
        end = int(round(bin_edges[i+1] / dz_cm))
        binned[i] = arr[start:end].sum()
    return binned

def bin_sum_2d(arr_2d, bin_edges, dz_cm):
    n_samples, _ = arr_2d.shape
    n_bins = len(bin_edges) - 1
    binned = np.zeros((n_samples, n_bins))
    for i in range(n_bins):
        start = int(round(bin_edges[i] / dz_cm))
        end = int(round(bin_edges[i+1] / dz_cm))
        binned[:, i] = arr_2d[:, start:end].sum(axis=1)
    return binned


def interpolate_theta(row, z_mid):
    theta_sensor = pd.to_numeric(row[[f"R{i}" for i in range(1, 7)]], errors="coerce").values

    for i in range(6):
        if np.isnan(theta_sensor[i]) and i > 0:
            theta_sensor[i] = theta_sensor[i - 1]
    for i in range(5, -1, -1):
        if np.isnan(theta_sensor[i]) and i < 5:
            theta_sensor[i] = theta_sensor[i + 1]

    theta_sensor = np.nan_to_num(theta_sensor, nan=0.0)
    theta_sensor = theta_sensor / 100.0

    layer_bounds = [
        (0, 20, theta_sensor[0], theta_sensor[0]),
        (20, 40, theta_sensor[0], theta_sensor[1]),
        (40, 70, theta_sensor[1], theta_sensor[2]),
        (70, 100, theta_sensor[2], theta_sensor[3]),
        (100, 130, theta_sensor[3], theta_sensor[4]),
        (130, 160, theta_sensor[4], theta_sensor[5])
    ]

    theta_mid = np.zeros_like(z_mid)
    for i, z in enumerate(z_mid):
        for (z1, z2, th1, th2) in layer_bounds:
            if z1 <= z <= z2:
                theta_mid[i] = th1 if th1 == th2 else th1 + (th2 - th1) * (z - z1) / (z2 - z1)
                break
    return theta_mid


def interpolate_theta_with_error(row, z_mid, theta_rel_sigma):
    theta_sensor = pd.to_numeric(row[[f"R{i}" for i in range(1, 7)]], errors="coerce").values

    for i in range(6):
        if np.isnan(theta_sensor[i]) and i > 0:
            theta_sensor[i] = theta_sensor[i - 1]
    for i in range(5, -1, -1):
        if np.isnan(theta_sensor[i]) and i < 5:
            theta_sensor[i] = theta_sensor[i + 1]

    theta_sensor = np.nan_to_num(theta_sensor, nan=0.0)
    eps = np.random.normal(0.0, theta_rel_sigma, size=theta_sensor.shape)
    theta_sensor = np.clip(theta_sensor + eps, 0.0, None)
    theta_sensor = theta_sensor / 100.0

    layer_bounds = [
        (0, 20, theta_sensor[0], theta_sensor[0]),
        (20, 40, theta_sensor[0], theta_sensor[1]),
        (40, 70, theta_sensor[1], theta_sensor[2]),
        (70, 100, theta_sensor[2], theta_sensor[3]),
        (100, 130, theta_sensor[3], theta_sensor[4]),
        (130, 160, theta_sensor[4], theta_sensor[5])
    ]

    theta_mid = np.zeros_like(z_mid)
    for i, z in enumerate(z_mid):
        for (z1, z2, th1, th2) in layer_bounds:
            if z1 <= z <= z2:
                theta_mid[i] = th1 if th1 == th2 else th1 + (th2 - th1) * (z - z1) / (z2 - z1)
                break
    return theta_mid


def compute_storage(theta_mid, dz_cm):
    S_layers = theta_mid * dz_cm * 10.0
    return S_layers, S_layers.sum()

# Mehod1
def bottom_up_min_drainage(DeltaS_layers, D_bal):
    N = len(DeltaS_layers)
    q = np.zeros(N + 1)
    ET = np.zeros(N)

    q[N] = max(D_bal, 0)

    for i in range(N - 1, -1, -1):
        q[i] = max(0, q[i + 1] + DeltaS_layers[i])
        ET[i] = q[i] - q[i + 1] - DeltaS_layers[i]
        if ET[i] < 0 and ET[i] > -1e-6:
            ET[i] = 0
    return q, ET


# Method2

def top_down_max_ET(DeltaS_layers, P_eff, ET_obs):
    N = len(DeltaS_layers)
    q = np.zeros(N + 1)
    ET = np.zeros(N)

    q[0] = max(P_eff, 0)
    R = max(ET_obs, 0)

    for i in range(N):
        ET_i_max = max(0, q[i] - DeltaS_layers[i])
        ET[i] = min(R, ET_i_max)
        q[i + 1] = q[i] - ET[i] - DeltaS_layers[i]
        if q[i + 1] < 0 and q[i + 1] > -1e-6:
            q[i + 1] = 0
        R -= ET[i]

    if q[N] < 0:
        q[N] = 0
    return q, ET


